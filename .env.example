DATABASE_URL=postgres://larecette:larecette@localhost:5434/larecette
CRON_SECRET=change-me
PAYLOAD_SECRET=change-me
# Emails: Mailpit in development (docker compose), any SMTP server in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@larecette.local
# Receives the quote requests and contact messages.
NOTIFY_EMAIL=contact@larecette.local

# Public URL of the site, used in email links.
SITE_URL=http://localhost:3000

# Stripe (test mode: keys from https://dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook` in development.
STRIPE_WEBHOOK_SECRET=whsec_...
